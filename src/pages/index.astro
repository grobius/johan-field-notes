---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileRail from '../components/ProfileRail.astro';
import NoteCard from '../components/NoteCard.astro';
import SensorTicker from '../components/SensorTicker.astro';
import { deskItems, site } from '../data/site';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
const allTags = [...new Set(notes.flatMap((note) => note.data.tags))].sort();
---

<BaseLayout>
  <div class="site-shell">
    <ProfileRail />
    <div class="main-column">
      <header class="topbar">
        <span>FIELD NOTES / 2026</span>
        <nav aria-label="Primary navigation">
          <a href="#notes">Notes</a>
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
        </nav>
      </header>

      <main id="content" class="content-wrap">
        <section class="hero">
          <p class="section-kicker">A personal field journal</p>
          <h1>Strategy, prototypes<br />and things I’m learning.</h1>
          <p>{site.intro}</p>
        </section>

        <section id="notes" aria-labelledby="notes-title">
          <div class="section-head">
            <div>
              <p class="section-kicker">Log entries</p>
              <h2 id="notes-title">Recent field notes</h2>
            </div>
            <div class="filters" aria-label="Filter notes">
              <button class="filter-button" type="button" data-filter="all" aria-pressed="true">All</button>
              {allTags.map((tag) => (
                <button class="filter-button" type="button" data-filter={tag.toLowerCase()} aria-pressed="false">{tag}</button>
              ))}
            </div>
          </div>
          <div class="notes-grid">
            {notes.map((note) => (
              <NoteCard
                id={note.id}
                title={note.data.title}
                description={note.data.description}
                published={note.data.published}
                tags={note.data.tags}
                kind={note.data.kind}
                featured={note.data.featured}
                image={note.data.image}
                imageAlt={note.data.imageAlt}
                imageLabel={note.data.imageLabel}
              />
            ))}
          </div>
        </section>

        <section id="projects" aria-labelledby="projects-title">
          <div class="section-head"><h2 id="projects-title">Selected projects &amp; work</h2></div>
          <div class="projects-grid">
            <a class="project-card" href="/notes/prototype-before-recommend/">
              <span class="project-icon" aria-hidden="true">◇</span>
              <div><h3>From question to prototype</h3><p>Small working models that make AI and architecture decisions more concrete.</p><span class="project-link">Read the approach ↗</span></div>
            </a>
            <a class="project-card" href="/notes/water-monitoring/">
              <span class="project-icon" aria-hidden="true">⌁</span>
              <div><h3>Low-power sensing</h3><p>A home-lab experiment in battery-powered sensors and useful, infrequent readings.</p><span class="project-link">Explore the lab ↗</span></div>
            </a>
          </div>
        </section>

        <section id="desk" aria-labelledby="desk-title">
          <div class="section-head">
            <div>
              <p class="section-kicker">Current state</p>
              <h2 id="desk-title">On my desk</h2>
            </div>
          </div>
          <div class="desk-grid">
            {deskItems.map((item) => (
              <div class="desk-item"><span>{item.label}</span><p>{item.title}</p></div>
            ))}
          </div>
        </section>
        <footer class="site-footer">Johan Sjöberg · Field notes, not finished answers.<a href={site.social.github} aria-label="Johan on GitHub">&gt;_</a></footer>
      </main>
    </div>
    <SensorTicker />
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.note-card');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? '').split('|');
          card.hidden = filter !== 'all' && !tags.includes(filter);
        });
      });
    });
  </script>
</BaseLayout>

---
import { site } from '../data/site';
---

<aside id="about" class="profile-rail" aria-label="About Johan">
  <div class="profile-sticky">
    <a class="wordmark" href="/" aria-label="Johan Sjöberg, home">
      <span class="prompt-mark" aria-hidden="true">&gt;_</span>
      <span>JS / FIELD NOTES</span>
    </a>

    <div class="profile-image-wrap">
      <img class="profile-image" src={site.profileImage} alt={site.profileImageAlt} width="320" height="320" />
      <span class="availability"><span></span> based in Stockholm</span>
    </div>

    <div class="profile-copy">
      <p class="section-kicker">About me</p>
      <h2>{site.name}</h2>
      <p>{site.bio}</p>
    </div>

    <nav class="social-links" aria-label="Social profiles">
      <a href={site.social.linkedin} target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.3H3.2V21h3.3V8.3ZM4.9 3A1.9 1.9 0 1 0 5 6.8 1.9 1.9 0 0 0 4.9 3ZM21 13.7c0-3.8-2-5.6-4.7-5.6-2.2 0-3.1 1.2-3.7 2V8.3H9.3V21h3.3v-6.3c0-1.7.3-3.3 2.4-3.3 2 0 2.1 1.9 2.1 3.4V21h3.3l.6-7.3Z"/></svg>
        <span>LinkedIn</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={site.social.github} target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5v-2.2c-2.6.6-3.1-1.1-3.1-1.1-.4-1.1-1-1.4-1-1.4-.9-.6 0-.6 0-.6 1 0 1.5 1 1.5 1 .8 1.5 2.2 1 2.7.8.1-.7.4-1.1.7-1.4-2.1-.2-4.3-1-4.3-4.7 0-1 .4-1.9 1-2.5-.1-.3-.4-1.2.1-2.5 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.8-1.3 2.6-1 2.6-1 .6 1.3.2 2.2.1 2.5.7.6 1.1 1.5 1.1 2.5 0 3.7-2.3 4.5-4.4 4.7.4.3.7.9.7 1.7v3.2A10 10 0 0 0 12 2Z"/></svg>
        <span>GitHub</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="focus-block">
      <p class="section-kicker">Exploring</p>
      <ul>
        {site.focus.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <p class="rail-footer">Built in the open with Astro + Cloudflare.</p>
  </div>
</aside>

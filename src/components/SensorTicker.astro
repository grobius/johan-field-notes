---
import { renderSensorReading } from '../lib/sensor-presentation';

const feedUrl = import.meta.env.PUBLIC_SENSOR_FEED_URL ?? '';
const samples = [
  { id: 'demo:temperature', label: 'Temperature', value: 18.6, unit: '°C', node: 'NODE 01' },
  { id: 'demo:humidity', label: 'Humidity', value: 62, unit: '%', node: 'NODE 02' },
  { id: 'demo:battery', label: 'Battery', value: 3.61, unit: 'V', node: 'NODE 03' },
  { id: 'demo:level', label: 'Water level', value: 1.24, unit: 'm', node: 'NODE 04' },
];
---
<section class="sensor-panel" aria-labelledby="sensor-title" data-sensor-feed={feedUrl}>
  <div class="sensor-heading"><h2 id="sensor-title"><span aria-hidden="true">&gt;_ </span>Sensor stream</h2><button type="button" class="sensor-pause" aria-label="Pause sensor animation" aria-pressed="false" hidden>Ⅱ</button></div>
  <p class="sensor-status" role="status">{feedUrl ? 'Connecting…' : 'Demo data'}</p>
  <div class="sensor-window" tabindex="0" aria-label="Sensor readings. Focus to pause movement.">
    <div class="sensor-track">
      <ul class="sensor-list" set:html={!feedUrl ? samples.map(sample => renderSensorReading(sample, true)).join('') : ''} />
    </div>
  </div>
  <p class="sensor-empty" hidden>No public readings yet.</p>
  <p class="sensor-caption">{feedUrl ? 'via The Things Network' : 'Preview · ready for The Things Network'}</p>
  <a class="sensor-link" href="/notes/water-monitoring/">Explore the lab ↗</a>
  <noscript><p>JavaScript is needed for updates and animation.</p></noscript>
</section>

<script>
  import { initSensorTicker } from '../scripts/sensor-ticker';
  document.querySelectorAll<HTMLElement>('[data-sensor-feed]').forEach(initSensorTicker);
</script>

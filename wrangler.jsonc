{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "johan-field-notes",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "johan_sensors",
			"database_name": "johan-sensors",
			"database_id": "f22f42dc-f68b-4c2c-a7ca-b62f20716a83"
		}
	]
}